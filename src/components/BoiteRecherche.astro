---
interface Props {
  valeur?: string;
  autofocus?: boolean;
}
const { valeur = '', autofocus = false } = Astro.props;
---
<div class="recherche">
  <form action="/css/recherche/" method="get" role="search">
    <label for="q" class="sr-only">Chercher dans les notules</label>
    <input
      type="search"
      id="q"
      name="q"
      value={valeur}
      autofocus={autofocus}
      placeholder="Chercher une œuvre, un compositeur, une salle…"
    />
    <button type="submit">Chercher</button>
  </form>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }
</style>
