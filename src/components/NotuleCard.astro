---
import { ouvrirDehors } from '../lib/liens';
import { origine } from '../lib/origine';
import { avertirMp3 } from '../lib/liens';
import { texteLisible } from '../lib/texte';

interface Props {
  notule: {
    data: {
      titre: string;
      url: string;
      date: Date;
      chapoHtml: string;
      corpsHtml?: string;
      vignette?: string;
      postId: number;
      extrait: string;
      categories: { nom: string; slug: string }[];
      nbCommentaires: number;
      auteur: string;
    };
  };
}
interface PropsSuite { illustration?: boolean; }

const { notule, illustration = true } = Astro.props;
const d = notule.data;

/**
 * ILLUSTRATION — la première image de la notule remplace le chapô.
 *
 * On lit le HTML du corps plutôt que de fabriquer une vignette : les
 * images sont déjà dans /medias/ et servies telles quelles. Le srcset
 * n'existe pas dans ce fonds hérité, on se contente donc de contraindre
 * la hauteur en CSS.
 *
 * Les images de très petite taille (puces, filets, icônes de notation)
 * sont écartées : une notule illustrée d'une puce de 12 px n'apporterait
 * rien. Faute de dimensions déclarées, on ne peut filtrer que sur celles
 * qui annoncent leur largeur.
 */
function premiereImage(html: string | undefined) {
  if (!html) return null;
  const balises = html.match(/<img\b[^>]*>/gi) ?? [];
  for (const balise of balises) {
    const src = balise.match(/\bsrc\s*=\s*["']([^"']+)["']/i)?.[1];
    if (!src) continue;
    const largeur = Number(balise.match(/\bwidth\s*=\s*["']?(\d+)/i)?.[1] ?? 0);
    if (largeur && largeur < 80) continue;
    const alt = balise.match(/\balt\s*=\s*["']([^"']*)["']/i)?.[1] ?? '';
    return { src, alt };
  }
  return null;
}

/* Une vignette explicite (import YouTube) prime sur la fouille du corps :
   l'iframe d'une vidéo ne contient aucune image à extraire. */
/**
 * BRÈVE — le texte entier paraît dans le fil.
 *
 * Deux provenances, deux traitements. Une notule d'archive porte son corps
 * en HTML dans `corpsHtml`, on l'injecte. Une notule Markdown n'a pas de
 * corps sous forme de chaîne : il est rendu par Astro à l'ouverture de la
 * page. C'est donc la page de fil qui en demande le rendu et le passe ici
 * en contenu d'élément — d'où le <slot/>.
 */
const estBreve = Boolean(d.breve);
const corpsDirect = estBreve && d.corpsHtml ? d.corpsHtml : '';

// L'étiquette « Brève » remplace celle de provenance : cumuler les deux
// alourdirait un fil dont l'intérêt est justement d'être léger.
const prov = estBreve
  ? { label: 'Brève', variante: 'provenance-breve' }
  : origine(d.postId);

const image = estBreve
  ? null
  : !illustration
  ? null
  : d.vignette
    ? { src: d.vignette, alt: '' }
    : premiereImage(d.corpsHtml);

const dateLongue = d.date.toLocaleDateString('fr-FR', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});

// Le chapô est du HTML Dotclear ; à défaut on retombe sur l'extrait en texte.
const chapo = d.chapoHtml?.trim();
---
<div class="day-date">{dateLongue}</div>

<article class="post">
  <div class="post-header">
    <h2 class="post-title">
      <span class:list={['provenance', prov.variante]}>{prov.label}</span>
      <a href={d.url}>{d.titre}</a>
    </h2>
  </div>

  {estBreve
    ? <div class="notule-corps breve-corps">
        {corpsDirect
          ? <Fragment set:html={avertirMp3(ouvrirDehors(corpsDirect), null)} />
          : <slot />}
      </div>
    : image
    ? <a class="post-illustration" href={d.url}>
        <img src={image.src} alt={image.alt} loading="lazy" />
      </a>
    : chapo
      ? <div class="post-chapo" set:html={ouvrirDehors(chapo)} />
      : <p class="post-chapo">{texteLisible(d.extrait)}</p>}

  <p class="post-info">
    Écrit par {d.auteur}
    {d.categories.length > 0 && (
      <>
        , dans {d.categories.map((c, i) => (
          <>{i > 0 && ', '}<a href={`/categorie/${c.slug}/`}>{c.nom}</a></>
        ))}
      </>
    )}
    {d.nbCommentaires > 0 && (
      <> — <a href={`${d.url}#commentaires`}>{d.nbCommentaires} indiscrets</a></>
    )}
  </p>
</article>

<style>
  .post-illustration {
    display: block;
    padding: .4em 1.2em 0;
    line-height: 0;
    text-align: center;
  }
  .provenance {
    display: inline-block;
    vertical-align: .18em;
    margin-right: .55em;
    padding: .1em .55em .15em;
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .52em;
    font-weight: normal;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #5e4718;
    background: #ecdcb0;
    border: 1px solid #d4bd85;
    border-radius: 2px;
  }
  /* Les vidéos se repèrent d'un coup d'œil dans le fil. */
  /* Violet nettement plus pâle : l'étiquette signale sans crier.
     Contraste du texte sur ce fond : 7,7 pour 1, très au-delà du
     minimum de 4,5 exigé pour un texte de cette taille. */
  .provenance-video {
    color: #55407a;
    background: #f2eefa;
    border-color: #ddd4ec;
  }
  /* Le fonds d'origine garde le doré de base, plus franc qu'auparavant :
     l'étiquette « Notule » était presque invisible sur le parchemin.
     Contraste : 6,5 pour 1. */
  /* Bleu très pâle, inspiré des motifs de Pelléas. Son détachement sur le
     parchemin est de 1,17 pour 1, exactement celui de l'étiquette dorée :
     les trois étiquettes pèsent ainsi le même poids à l'œil. Le texte y
     est à 5,96 pour 1, au-delà du seuil de 4,5 exigé à cette taille. */
  .provenance-breve {
    color: #2f5468;
    background: #d0dfeb;
    border-color: #aec3d6;
  }

  .provenance-notule {
    color: #5e4718;
    background: #ecdcb0;
    border-color: #d4bd85;
  }

  .post-illustration img {
    max-height: 320px;
    width: auto;
    max-width: 100%;
    border: 1px solid var(--parch-dark);
  }
</style>

<style is:global>
  /* Le corps d'une brève, dans le fil. Le fond de la carte ne change pas :
     seule l'étiquette signale la nature du texte. */
  .breve-corps {
    padding: .2em 1.2em .4em;
    margin-left: 0;
    margin-right: 0;
    max-width: none;
  }
  .breve-corps > :first-child { margin-top: 0; }
  .breve-corps > :last-child  { margin-bottom: 0; }
</style>
