---
import '../styles/global.css';
import BoiteRecherche from '../components/BoiteRecherche.astro';
import Antiquites from '../components/Antiquites.astro';

interface Props {
  titre: string;
  description?: string;
  soustitre?: string;
  devise?: boolean;
  type?: 'website' | 'article';
  canonique?: string;
  datePublication?: Date;
  /** Barre d'outils (Recherche + Antiquités). Coupée sur /css/recherche/. */
  outils?: boolean;
  menu?: boolean;
}

const SOUSTITRE = 'Musiques interlopes depuis 2005.';
const DESCRIPTION = "Notules d'opéra, de disques et de promenades — depuis 2005.";

/** Adresse de contact, commune au pied de page et aux commentaires. */
export const COURRIEL = 'carnetsol1598@gmail.com';

const {
  titre,
  description = DESCRIPTION,
  soustitre = SOUSTITRE,
  devise = false,
  type = 'website',
  canonique,
  datePublication,
  outils = true,
  menu = true,
} = Astro.props;

const urlCanonique = new URL(canonique ?? Astro.url.pathname, Astro.site);

/**
 * Image de partage. cello.jpg fait 161 x 121 px, sous le minimum de
 * 200 x 200 exigé par la plupart des réseaux : aucune vignette ne
 * s'affichera tant qu'une version plus grande n'aura pas été fournie.
 * La carte reste donc sur « summary ».
 */
const imagePartage = new URL('/partage.jpg', Astro.site);

const rubriques = [
  { href: '/categorie/', label: 'Chapitres' },
  { href: '/archives/',  label: 'Archives' },
  // L'agenda est une notule comme une autre : son adresse changera à
  // chaque nouvelle saison. C'est la seule ligne à modifier alors.
  { href: '/css/2026/08/16/3457-l-agenda-de-francilie-2026-2027-rentree-de-septembre/',
    label: 'Agenda' },
  { href: 'https://linktr.ee/carnetsol', label: 'Linktree', externe: true },
];

const contact = `mailto:${COURRIEL}`
  + '?subject=' + encodeURIComponent('Contact — Carnets sur sol');
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{titre} — Carnets sur sol</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={urlCanonique} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="alternate" type="application/rss+xml" title="Carnets sur sol" href="/css/rss.xml" />

  <meta property="og:site_name" content="Carnets sur sol" />
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:title" content={titre} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={urlCanonique} />
  <meta property="og:image" content={imagePartage} />
  <meta property="og:image:width" content="161" />
  <meta property="og:image:height" content="121" />

  {type === 'article' && datePublication && (
    <meta property="article:published_time" content={datePublication.toISOString()} />
  )}
  {type === 'article' && <meta property="article:author" content="David Le Marrec" />}

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={titre} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imagePartage} />
</head>
<body>

  <header id="top">
    <a class="vignette" href="/css/" aria-label="Accueil de Carnets sur sol">
      <img src="/cello.jpg" alt="" width="161" height="121" />
    </a>

    <h1><a href="/css/">Carnets sur sol</a></h1>
    {devise && <p class="tagline">{soustitre}</p>}
  </header>

  {menu && (
    <nav class="menu" aria-label="Rubriques">
      <ul>
        {rubriques.map((r) => (
          <li>
            <a
              href={r.href}
              target={r.externe ? '_blank' : undefined}
              rel={r.externe ? 'noopener noreferrer' : undefined}
            >{r.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  {outils && (
    <div class="outils">
      <BoiteRecherche encart />
      <Antiquites />
    </div>
  )}

  <main>
    <slot />
  </main>

  <footer id="footer">
    ISSN <a href="https://catalogue.bnf.fr/ark:/12148/cb43668591m.public"
            target="_blank" rel="noopener noreferrer">2269-2843</a> ·
    Carnets sur sol — <a href={contact}>David Le Marrec</a> — depuis 2005 ·
    <a href="/css/rss.xml">Flux RSS</a>
  </footer>

</body>
</html>
