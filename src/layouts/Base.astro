---
import '../styles/global.css';
import BoiteRecherche from '../components/BoiteRecherche.astro';
import Antiquites from '../components/Antiquites.astro';
import { GOATCOUNTER, COURRIEL } from '../config';

interface Props {
  titre: string;
  description?: string;
  soustitre?: string;
  devise?: boolean;
  type?: 'website' | 'article';
  canonique?: string;
  datePublication?: Date;
  /** Encart de recherche. Réservé aux Chapitres et aux Archives. */
  recherche?: boolean;
  /** Encart Antiquités. Réservé à l'accueil et aux pages de notule. */
  antiquites?: boolean;
  menu?: boolean;
}

const SOUSTITRE = 'Musiques interlopes depuis 2005.';
const DESCRIPTION = 'Musiques interlopes depuis 2005.';

const {
  titre,
  description = DESCRIPTION,
  soustitre = SOUSTITRE,
  titrePartage,
  devise = false,
  type = 'website',
  canonique,
  datePublication,
  recherche = false,
  antiquites = false,
  menu = true,
} = Astro.props;

const urlCanonique = new URL(canonique ?? Astro.url.pathname, Astro.site);

const titreOuvert = titrePartage ?? titre;

/**
 * Image de partage : le ballet des nonnes de Robert le Diable.
 *
 * 1200 x 630 px, format exact d'Open Graph. Les réseaux ne redimensionnent
 * pas, ils RECADRENT au centre ce qui n'est pas à leur rapport : la
 * gravure d'origine, au rapport 1,35, y aurait perdu 29 % de sa hauteur —
 * le plafond et les premiers rangs. Elle est donc posée entière sur un
 * fond parchemin, aux couleurs du site, qui comble la différence. Rien
 * n'est rogné nulle part, et le cadrage reste choisi plutôt que subi.
 */
const imagePartage = new URL('/partage.jpg', Astro.site);

const rubriques = [
  { href: '/categorie/', label: 'Chapitres' },
  { href: '/archives/',  label: 'Archives' },
  // L'agenda est une notule comme une autre : son adresse changera à
  // chaque nouvelle saison. C'est la seule ligne à modifier alors.
  { href: '/css/2026/09/03/3462-agenda-2026-2027/',
    label: 'Agenda' },
  { href: 'https://linktr.ee/carnetsol', label: 'Linktree', externe: true },
];

const contact = `mailto:${COURRIEL}`
  + '?subject=' + encodeURIComponent('Contact — Carnets sur sol');
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{titre} — Carnets sur sol</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={urlCanonique} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="alternate" type="application/rss+xml" title="Carnets sur sol" href="/css/rss.xml" />

  <meta property="og:site_name" content="Carnets sur sol" />
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:title" content={titreOuvert} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={urlCanonique} />
  <meta property="og:image" content={imagePartage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  {type === 'article' && datePublication && (
    <meta property="article:published_time" content={datePublication.toISOString()} />
  )}
  {type === 'article' && <meta property="article:author" content="David Le Marrec" />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titreOuvert} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imagePartage} />
  <meta property="og:image:alt" content="Le ballet des nonnes de Robert le Diable, à l'Opéra" />

  {/* Mesure d'audience. Sans identifiant dans src/config.ts, rien n'est
      émis : pas de script, pas de requête, pas de cookie. GoatCounter ne
      pose aucun cookie et respecte Do Not Track de lui-même. */}
  {GOATCOUNTER && (
    <script
      is:inline
      data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`}
      async
      src="//gc.zgo.at/count.js"
    ></script>
  )}
</head>
<body>

  <header id="top">
    <a class="vignette" href="/css/" aria-label="Accueil de Carnets sur sol">
      <img src="/cello.jpg" alt="" width="161" height="121" />
    </a>

    <h1><a href="/css/">Carnets sur sol</a></h1>
    {devise && <p class="tagline">{soustitre}</p>}
  </header>

  {menu && (
    <nav class="menu" aria-label="Rubriques">
      <ul>
        {rubriques.map((r) => (
          <li>
            <a
              href={r.href}
              target={r.externe ? '_blank' : undefined}
              rel={r.externe ? 'noopener noreferrer' : undefined}
            >{r.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  {(recherche || antiquites) && (
    <div class="outils">
      {recherche && <BoiteRecherche encart />}
      {antiquites && <Antiquites />}
    </div>
  )}

  <main>
    <slot />
  </main>

  <footer id="footer">
    <a href="https://catalogue.bnf.fr/ark:/12148/cb43668591m.public"
       target="_blank" rel="noopener noreferrer">ISSN 2269-2843</a> ·
    Carnets sur sol — <a href={contact}>David Le Marrec</a> — depuis 2005 ·
    <a href="/css/rss.xml">Flux RSS</a>
  </footer>

</body>
</html>
