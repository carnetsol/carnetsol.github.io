           <td valign=\"top\">Aus \"Die Nonne und der Ritter\" </td>\r\n                  <td valign=\"top\" width=\"27\"><br>\r\n                  </td>\r\n                  <td valign=\"top\"><br>\r\n                  </td>\r\n                </tr>\r\n                <tr>\r\n                  <td valign=\"top\" width=\"27\">  </td>\r\n                  <td valign=\"top\"><span style=\"font-weight: bold;\">Modeste\r\nMoussorgski</span> <br>\r\n                  <span style=\"font-style: italic;\">Ohne Sonne </span>\r\n                  <br>\r\nGedichte von Arseni Golenichtchev-Koutouzov </td>\r\n                  <td valign=\"top\" width=\"27\"><br>\r\n                  </td>\r\n                  <td valign=\"top\"><br>\r\n                  </td>\r\n                </tr>\r\n                <tr>\r\n                  <td valign=\"top\" width=\"27\">8 </td>\r\n                  <td valign=\"top\">In den vier Wänden </td>\r\n                  <td valign=\"top\" width=\"27\"><br>\r\n                  </td>\r\n                  <td valign=\"top\"><br>\r\n                  </td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <table class=\"cdindex\" cellpadding=\"0\">\r\n              <tbody>\r\n                <tr>\r\n                  <td valign=\"top\" width=\"27\">9 </td>\r\n                  <td valign=\"top\">Du hast mich nicht erkannt in der\r\nMenge </td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <table class=\"cdindex\" cellpadding=\"0\">\r\n              <tbody>\r\n                <tr>\r\n                  <td valign=\"top\" width=\"27\">10 </td>\r\n                  <td valign=\"top\">Am Ende eines vergeblichen Tages </td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <table class=\"cdindex\" cellpadding=\"0\">\r\n              <tbody>\r\n                <tr>\r\n                  <td valign=\"top\" width=\"27\">11 </td>\r\n     