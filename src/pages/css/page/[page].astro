---
import { getCollection, render } from 'astro:content';
import { notulesPourListe } from '../../../lib/notules';
import Base from '../../../layouts/Base.astro';
import NotuleCard from '../../../components/NotuleCard.astro';
import Pagination from '../../../components/Pagination.astro';

/**
 * Ce fichier ne produit QUE les pages 2 et suivantes : la page 1 reste
 * /css/, adresse historique du fil. Générer aussi /css/page/1/ créerait
 * un doublon exact à l'autre bout du site.
 *
 * Le segment `page` est statique : cette route est plus spécifique que
 * /css/[...permalien].astro et lui est donc préférée par Astro. Aucun
 * permalien Dotclear ne commence par « page/ », il n'y a pas de collision.
 */
export async function getStaticPaths() {
  // Déclaré ICI et non dans la portée du composant : Astro hisse
  // getStaticPaths dans un module séparé, qui ne voit rien du frontmatter.
  const PAR_PAGE = 50;

  const toutes = await notulesPourListe();
  const triees = toutes.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  const total = triees.length;
  const nbPages = Math.max(1, Math.ceil(total / PAR_PAGE));

  const pages = [];
  for (let p = 2; p <= nbPages; p++) {
    pages.push({
      params: { page: String(p) },
      props: {
        liste: triees.slice((p - 1) * PAR_PAGE, p * PAR_PAGE),
        page: p,
        nbPages,
        total,
      },
    });
  }
  return pages;
}

const { liste, page, nbPages, total } = Astro.props;

/**
 * Corps des brèves écrites en Markdown.
 *
 * Astro ne rend le Markdown qu'à travers un composant, jamais sous forme
 * de chaîne : on ne peut donc pas le glisser dans NotuleCard comme une
 * propriété. On demande ici le rendu de chaque brève — elles sont peu
 * nombreuses, le coût est négligeable — et on passe le composant obtenu
 * en contenu d'élément. Les brèves d'archive, elles, portent déjà leur
 * HTML et n'ont pas besoin de ce détour.
 */
const corpsDeBreve = new Map();
for (const n of liste) {
  if (n.data.breve && n.source === 'markdown') {
    const { Content } = await render(n.entree);
    corpsDeBreve.set(n.data.url, Content);
  }
}

---
<Base titre={`Notules — page ${page}`}>


  <div class="contenu">
    <div id="fil">
      {liste.map((notule) => {
        const Corps = corpsDeBreve.get(notule.data.url);
        return Corps
          ? <NotuleCard notule={notule}><Corps /></NotuleCard>
          : <NotuleCard notule={notule} />;
      })}
    </div>

    <Pagination page={page} nbPages={nbPages} total={total} affichees={liste.length} />
  </div>

</Base>
