---
import { getCollection } from 'astro:content';
import { notulesPubliees } from '../../lib/notules';
import Base from '../../layouts/Base.astro';
import NotuleCard from '../../components/NotuleCard.astro';
import Pagination from '../../components/Pagination.astro';

const PAR_PAGE = 50;

const toutes = await notulesPubliees(await getCollection('notules'));
const triees = toutes.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const premieres = triees.slice(0, PAR_PAGE);
const total = triees.length;
const nbPages = Math.max(1, Math.ceil(total / PAR_PAGE));
---
<Base titre="Notules récentes" devise>


  <div class="contenu">
    {/* #fil : le conteneur où le bouton « Charger les 50 suivantes »
        recopie les notules de la page suivante. */}
    <div id="fil">
      {premieres.map((notule) => <NotuleCard notule={notule} />)}
    </div>

    <Pagination page={1} nbPages={nbPages} total={total} affichees={premieres.length} />
  </div>

</Base>
