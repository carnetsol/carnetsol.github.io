---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugifier, chargerCorrections, appliquerCorrection, notulesPubliees, urlDeNouvelle } from '../../lib/notules';
import { ouvrirDehors, avertirMp3 } from '../../lib/liens';
import { GOATCOUNTER, METTRE_LES_CHIFFRES_EN_PUBLIC } from '../../config';
import { texteLisible } from '../../lib/texte';

/**
 * Une seule route sert trois choses :
 *   1. les archives      -> /css/AAAA/MM/JJ/<id>-<slug>/  (permalien Dotclear)
 *   2. les nouvelles     -> /css/AAAA/MM/JJ/<slug>/
 *   3. les ALIAS         -> toute autre écriture du même permalien
 *
 * Le point 3 est indispensable : Dotclear résolvait une notule par son
 * IDENTIFIANT et se moquait de la suite du slug. Ces trois adresses
 * menaient donc à la même page :
 *     /css/2013/04/04/2230-michelangelo-falvetti-le-deluge-universel-...
 *     /css/2013/04/04/2230-michelangelo-falvetti
 *     /css/2013/04/04/2230
 * Vingt ans de liens internes (et externes) utilisent ces formes abrégées.
 * Sans alias, elles deviendraient autant de liens morts.
 */
export async function getStaticPaths() {
  // Dépubliées : ni page, ni alias, ni place dans la chaîne des voisines.
  const archives = await notulesPubliees(await getCollection('notules'));
  const nouvelles = await getCollection('nouvelles', ({ data }) => !data.brouillon);
  const cats = await getCollection('categories');
  const parNom = new Map(cats.map((c) => [c.data.nom.toLowerCase(), c.data.slug]));
  const correctifs = await chargerCorrections();

  // --- 0. voisinage chronologique -------------------------------------
  // Archives et nouvelles confondues : le fil de lecture ne doit pas
  // buter sur la frontière entre le corpus importé et les billets récents.
  // Une seule définition de l'adresse, partagée avec les pages de liste :
  // deux formules divergentes produiraient des liens morts silencieux.
  const urlNouvelle = (n) => urlDeNouvelle(n.data);

  const chrono = [
    ...archives.map((n) => ({ url: n.data.url, titre: n.data.titre, date: n.data.date })),
    ...nouvelles.map((n) => ({ url: urlNouvelle(n), titre: n.data.titre, date: n.data.date })),
  ].sort(
    (a, b) => b.date.valueOf() - a.date.valueOf() || a.url.localeCompare(b.url)
  );

  // Liste triée du plus récent au plus ancien : l'index suivant est la
  // notule PRÉCÉDENTE dans le temps, l'index antérieur la SUIVANTE.
  const voisines = new Map();
  chrono.forEach((n, i) => {
    voisines.set(n.url, {
      precedente: chrono[i + 1] ? { url: chrono[i + 1].url, titre: chrono[i + 1].titre } : null,
      suivante:   chrono[i - 1] ? { url: chrono[i - 1].url, titre: chrono[i - 1].titre } : null,
    });
  });

  const sansVoisines = { precedente: null, suivante: null };

  const chemins = [];
  const pris = new Set();

  const ajouter = (param, props) => {
    if (pris.has(param)) return;   // Astro refuse deux routes identiques
    pris.add(param);
    chemins.push({ params: { permalien: param }, props });
  };

  // --- 1. les permaliens réels ---------------------------------------
  const parIdentifiant = new Map();
  for (const notule of archives) {
    const param = notule.data.url.replace(/^\/css\//, '').replace(/\/$/, '');
    parIdentifiant.set(notule.data.postId, notule.data.url);
    ajouter(param, {
      archive: { ...notule, data: appliquerCorrection(notule.data, correctifs.get(notule.data.postId)) },
      nouvelle: null,
      redirection: null,
      ...(voisines.get(notule.data.url) ?? sansVoisines),
    });
  }

  for (const n of nouvelles) {
    const d = n.data.date;
    const an = d.getFullYear();
    const mois = String(d.getMonth() + 1).padStart(2, '0');
    const jour = String(d.getDate()).padStart(2, '0');
    const slug = n.data.slug || slugifier(n.data.titre);
    const segment = n.data.postId ? `${n.data.postId}-${slug}` : slug;

    ajouter(`${an}/${mois}/${jour}/${segment}`, {
      archive: null,
      nouvelle: n,
      redirection: null,
      categories: n.data.categories.map((nom) => ({
        nom,
        slug: parNom.get(nom.toLowerCase()) ?? slugifier(nom),
      })),
      ...(voisines.get(urlNouvelle(n)) ?? sansVoisines),
    });

    // Une notule Markdown REPRISE de l'ancien site porte un postId : elle
    // mérite les mêmes alias qu'une notule d'archive, sans quoi les liens
    // anciens — et le rattrapage du 404, qui vise la forme nue —
    // tomberaient à côté.
    if (n.data.postId) {
      ajouter(`${an}/${mois}/${jour}/${n.data.postId}`, {
        archive: null, nouvelle: null, redirection: urlNouvelle(n),
      });
      ajouter(String(n.data.postId), {
        archive: null, nouvelle: null, redirection: urlNouvelle(n),
      });
    }
  }

  // --- 2. les alias ---------------------------------------------------
  // a) forme nue : /css/AAAA/MM/JJ/<id>
  for (const notule of archives) {
    const m = notule.data.url.match(/^\/css\/(\d{4})\/(\d{2})\/(\d{2})\/(\d+)-/);
    if (m) {
      ajouter(`${m[1]}/${m[2]}/${m[3]}/${m[4]}`, {
        archive: null, nouvelle: null, redirection: notule.data.url,
      });
    }
  }

  // a bis) forme la plus courte : /css/<id>
  // Permet de taper « carnetsol.fr/css/3457 » dans la barre d'adresse.
  // Un identifiant à quatre chiffres crée /css/2013/, qui cohabite sans
  // heurt avec /css/2013/01/… : l'un est un fichier index.html, l'autre
  // un dossier. Aucun permalien réel n'a cette forme, donc pas de conflit.
  for (const notule of archives) {
    ajouter(String(notule.data.postId), {
      archive: null, nouvelle: null, redirection: notule.data.url,
    });
  }

  // b) toute forme abrégée réellement rencontrée dans le corpus
  const motif = /\/css\/(\d{4})\/(\d{2})\/(\d{2})\/(\d+)(-[^"'\s>)#]*)?/g;
  for (const notule of archives) {
    const textes = [
      notule.data.corpsHtml ?? '',
      notule.data.chapoHtml ?? '',
      notule.data.notesHtml ?? '',
      ...(notule.data.commentaires ?? []).map((c) => c.contenu ?? ''),
    ];
    for (const texte of textes) {
      for (const m of texte.matchAll(motif)) {
        const cible = parIdentifiant.get(Number(m[4]));
        if (!cible) continue;   // notule jamais publiée : rien à viser

        // Supprime les caractères interdits sous Windows dans le slug d'alias (ex: | ] ? *)
        const slugNettoye = (m[5] ?? '')
          .replace(/\/$/, '')
          .replace(/[|?:*<>"\\\]\[]+/g, '');

        const param = `${m[1]}/${m[2]}/${m[3]}/${m[4]}${slugNettoye}`;
        ajouter(param, { archive: null, nouvelle: null, redirection: cible });
      }
    }
  }

  return chemins;
}

const {
  archive,
  nouvelle,
  categories: catsNouvelle,
  redirection,
  precedente = null,
  suivante = null,
} = Astro.props;

const d = archive?.data;
const titre = archive ? d.titre : nouvelle?.data.titre;
const date = archive ? d.date : nouvelle?.data.date;
const auteur = archive ? d.auteur : nouvelle?.data.auteur;
const categories = archive ? d.categories : catsNouvelle;
// Nettoyé ici aussi : cet extrait part dans <meta description> et
// dans les aperçus de partage, où une entité visible ferait tache.
const extrait = texteLisible(archive ? d.extrait : nouvelle?.data.chapo);

const Contenu = nouvelle ? (await render(nouvelle)).Content : null;

const dateLongue = date?.toLocaleDateString('fr-FR', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});

/* Le site est statique : aucun serveur ne peut recevoir un formulaire.
   Le lien compose donc un courriel prérempli. Le titre et l'adresse de la
   notule sont glissés dans le corps du message pour savoir de quoi il
   retourne sans avoir à chercher. */
/**
 * Adresse de la notule sur l'ancien site, encore en ligne.
 *
 * Les notules au-delà de 90000 viennent des blogs compagnons (WordPress,
 * fil Twitter) : elles n'ont jamais eu de page sur /css/, le renvoi n'aurait
 * aucun sens pour elles.
 */
const urlAncienne = archive && d.postId < 90000
  ? 'http://operacritiques.free.fr/css/index.php?'
    + `${d.date.getFullYear()}/`
    + `${String(d.date.getMonth() + 1).padStart(2, '0')}/`
    + `${String(d.date.getDate()).padStart(2, '0')}/`
    + `${d.postId}-${d.slug}`
  : null;

const compteurVisible = Boolean(GOATCOUNTER) && METTRE_LES_CHIFFRES_EN_PUBLIC;

const lienCommentaire =
  'mailto:carnetsol1598@gmail.com'
  + '?subject=' + encodeURIComponent('Nouveau commentaire sur Carnets sur sol')
  + '&body=' + encodeURIComponent(
      `\n\n---\nÀ propos de : ${titre ?? ''}\n`
      + new URL(Astro.url.pathname, Astro.site).href + '\n'
    );
---
{redirection ? (
  <html lang="fr">
    <head>
      <meta charset="utf-8" />
      <title>Redirection</title>
      {/* canonical : les moteurs rattachent cette adresse à la vraie notule */}
      <link rel="canonical" href={new URL(redirection, Astro.site)} />
      <meta http-equiv="refresh" content={`0; url=${redirection}`} />
      <meta name="robots" content="noindex, follow" />
    </head>
    <body>
      <p>Cette notule se trouve désormais ici : <a href={redirection}>{redirection}</a></p>
    </body>
  </html>
) : (
<Base titre={titre} description={extrait} type="article" datePublication={date} antiquites>

  <div class="contenu" data-pagefind-body>
    <div class="day-date">{dateLongue}</div>

    <article class="post">
      <div class="post-header">
        <h1 class="post-title">{titre}</h1>
      </div>

      {archive && d.chapoHtml?.trim() && (
        <div class="post-chapo" set:html={ouvrirDehors(d.chapoHtml)} />
      )}

      {archive
        ? <div class="notule-corps" set:html={avertirMp3(ouvrirDehors(d.corpsHtml), urlAncienne)} />
        : <div class="notule-corps"><Contenu /></div>}

      {archive && d.notesHtml?.trim() && (
        <div class="notule-notes" set:html={ouvrirDehors(d.notesHtml)} />
      )}

      <p class="post-info">
        Écrit par {auteur}
        {categories?.length > 0 && (
          <>
            , dans {categories.map((c, i) => (
              <>{i > 0 && ', '}<a href={`/categorie/${c.slug}/`}>{c.nom}</a></>
            ))}
          </>
        )}
      </p>
    {compteurVisible && (
      /* Le compteur est demandé APRÈS l'affichage, par le navigateur.
         Tant que la réponse n'arrive pas, rien ne s'affiche : mieux vaut
         un blanc qu'un « 0 lecture » qui serait faux. */
      <p class="lectures" data-lectures hidden data-pagefind-ignore></p>
    )}

    </article>

    {(precedente || suivante) && (
      /* data-pagefind-ignore : sans cela, le titre des deux notules
         voisines serait indexé dans le texte de celle-ci et la recherche
         renverrait des faux positifs sur trois pages à chaque fois. */
      <nav class="voisines" aria-label="Notules voisines" data-pagefind-ignore>
        {precedente ? (
          <a class="v-prec" href={precedente.url} rel="prev">
            <span class="v-sens">Notule précédente</span>
            <span class="v-titre">{precedente.titre}</span>
          </a>
        ) : <span class="v-vide" />}

        {suivante ? (
          <a class="v-suiv" href={suivante.url} rel="next">
            <span class="v-sens">Notule suivante</span>
            <span class="v-titre">{suivante.titre}</span>
          </a>
        ) : <span class="v-vide" />}
      </nav>
    )}

    {archive && d.commentaires.length > 0 && (
      <section id="commentaires">
        <h2 class="section-head">
          {d.commentaires.length}
          {d.commentaires.length > 1 ? ' roulades' : ' portamento'}
        </h2>
        {d.commentaires.map((c) => (
          <article class="commentaire" id={`c${c.id}`}>
            <p class="commentaire-info">
              {c.site
                ? <a href={c.site} target="_blank" rel="nofollow noopener noreferrer">{c.auteur}</a>
                : c.auteur}
              {c.date && (
                <> — {new Date(c.date).toLocaleDateString('fr-FR', {
                  day: 'numeric', month: 'long', year: 'numeric',
                })}</>
              )}
            </p>
            <div class="commentaire-corps" set:html={ouvrirDehors(c.contenu)} />
          </article>
        ))}
        <p class="commentaires-clos">
          Les commentaires sont clos sur le site archivé.
        </p>
      </section>
    )}

    {/* Le site est statique : aucun serveur ne peut recevoir un
        formulaire. Le lien compose donc un courriel prérempli, que
        David recopie ensuite dans le corps de la notule. Le titre et
        l'adresse de la notule sont glissés dans le message pour qu'il
        sache de quoi il retourne sans avoir à chercher. */}
    <section class="ecrire" data-pagefind-ignore>
      <p>
        Pour ajouter votre commentaire,
        <a href={lienCommentaire}>envoyez-le ici</a>.
        Je le publierai à réception. (Sauf mention contraire, bien sûr.)
      </p>
    </section>
  </div>

</Base>
)}

{compteurVisible && (
  <script is:inline define:vars={{ code: GOATCOUNTER }}>
    /**
     * Nombre de lectures, demandé à GoatCounter après affichage de la page.
     *
     * L'appel ne bloque rien : si GoatCounter est injoignable, si un
     * bloqueur l'arrête, ou si l'option « Allow adding visitor counts » n'a
     * pas été cochée dans les réglages, la ligne reste simplement cachée.
     * Un échec silencieux vaut mieux qu'un zéro, qui serait un mensonge.
     *
     * Le compteur n'est demandé QUE sur les pages de notule : dans le fil,
     * cinquante notules affichées feraient cinquante requêtes.
     */
    (async function () {
      if (!code) return;
      const cible = document.querySelector('[data-lectures]');
      if (!cible) return;
  
      const chemin = encodeURIComponent(location.pathname);
      const adresse = `https://${code}.goatcounter.com/counter/${chemin}.json`;
  
      try {
        const reponse = await fetch(adresse);
        if (!reponse.ok) return;
        const donnees = await reponse.json();
        const brut = String(donnees.count ?? '').replace(/[^0-9]/g, '');
        const n = Number(brut);
        if (!n) return;
  
        cible.textContent = n === 1
          ? '1 lecture'
          : `${n.toLocaleString('fr-FR')} lectures`;
        cible.hidden = false;
      } catch {
        /* rien : la ligne reste cachée */
      }
    })();
  </script>
)}

<style>
  /* ---------- Notules voisines ---------- */
  .voisines {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em;
    margin: 2em 0 2.5em;
    padding-top: 1.2em;
    border-top: 1px solid var(--gold-line);
  }
  .voisines a {
    display: block;
    padding: .7em .9em;
    background: var(--frame-bg);
    border: 1px solid var(--parch-dark);
    border-radius: 2px;
  }
  .voisines a:hover { border-color: var(--gold-frame); }
  .v-suiv { text-align: right; }
  .v-sens {
    display: block;
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .72em;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: .25em;
  }
  .v-prec .v-sens::before { content: "« "; }
  .v-suiv .v-sens::after  { content: " »"; }
  .v-titre {
    display: block;
    font-family: Georgia, serif;
    font-size: .95em;
    line-height: 1.35;
    color: var(--ink);
  }
  .voisines a:hover .v-titre { color: #8d6e68; }

  /* Une notule en bout de corpus n'a qu'un seul voisin : la cellule vide
     maintient l'autre lien dans sa colonne. */
  .v-vide { display: block; }

  @media (max-width: 640px) {
    .voisines { grid-template-columns: 1fr; }
    .v-suiv { text-align: left; }
  }

  .commentaire {
    border-left: 2px solid var(--parch-dark);
    background: var(--frame-bg);
    padding: .1em 1em .3em;
    margin-bottom: 1em;
    font-size: .95em;
  }
  .commentaire-info {
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .8em; color: var(--muted); margin: .8em 0 .2em;
  }
  .lectures {
    max-width: var(--largeur-texte);
    margin: .8em auto 0;
    padding: 0 1.2em;
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .78em;
    color: var(--muted);
  }

  .note-mp3 {
    background: var(--parch-mid);
    border-left: 3px solid var(--gold-frame);
    padding: .6em .9em;
    margin: 1em 0;
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .84em;
  }

  .ecrire {
    max-width: var(--largeur-texte);
    margin: 2em auto 0;
    padding: 1em 1.2em;
    background: var(--parch-mid);
    border-left: 3px solid var(--gold-frame);
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .88em;
  }
  .ecrire p { margin: 0; }

  .commentaires-clos {
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .8em; color: var(--muted); font-style: italic;
  }
</style>