---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { notulesPubliees } from '../../lib/notules';

const notules = await notulesPubliees(await getCollection('notules'));
const triees = notules.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Regroupement année -> mois -> notules
const parAnnee = new Map<number, Map<number, typeof triees>>();
for (const n of triees) {
  const a = n.data.date.getFullYear();
  const m = n.data.date.getMonth();
  if (!parAnnee.has(a)) parAnnee.set(a, new Map());
  const mois = parAnnee.get(a)!;
  if (!mois.has(m)) mois.set(m, []);
  mois.get(m)!.push(n);
}

const nomMois = [
  'janvier', 'février', 'mars', 'avril', 'mai', 'juin',
  'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre',
];

const annees = [...parAnnee.entries()];

/**
 * Hauteur approximative d'une section d'année, pour `contain-intrinsic-size`.
 *
 * Tout est désormais affiché : la page fait plusieurs milliers de lignes.
 * `content-visibility: auto` demande au navigateur de ne calculer la mise
 * en page d'une année que lorsqu'elle approche de l'écran ; encore faut-il
 * lui donner une hauteur présumée, sans quoi l'ascenseur saute pendant le
 * défilement. On la calcule ici à la compilation plutôt que d'en poser une
 * au jugé, identique pour 2005 (peu de notules) et pour 2012 (beaucoup).
 *
 * Le mot-clé `auto` en tête fait que la valeur mesurée au premier rendu
 * remplace ensuite l'estimation.
 */
const hauteurEstimee = (mois: Map<number, typeof triees>) => {
  const nbNotules = [...mois.values()].reduce((s, l) => s + l.length, 0);
  return 60 + mois.size * 38 + nbNotules * 34;
};
---
<Base titre="Archives">

  <div class="contenu">
    <h2 class="section-head">Archives — {triees.length.toLocaleString('fr-FR')} notules</h2>

    <nav class="index-annees" aria-label="Aller à une année">
      {annees.map(([annee]) => (
        <a href={`#a${annee}`}>{annee}</a>
      ))}
    </nav>

    {annees.map(([annee, mois]) => (
      <section class="annee" id={`a${annee}`} style={`contain-intrinsic-size: auto ${hauteurEstimee(mois)}px`}>
        <h3>
          {annee}
          <span class="an-compte">
            {[...mois.values()].reduce((s, l) => s + l.length, 0)} notules
          </span>
          <a class="an-haut" href="#top" aria-label={`Remonter depuis ${annee}`}>haut</a>
        </h3>

        {[...mois.entries()].map(([m, liste]) => (
          <section class="mois">
            <h4>
              {nomMois[m]} {annee}
              <span class="compte">
                ({liste.length} {liste.length > 1 ? 'notules' : 'notule'})
              </span>
            </h4>
            <ul class="liste">
              {liste.map((n) => (
                <li>
                  <span class="r-date">
                    {n.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}
                  </span>
                  <span class="r-title"><a href={n.data.url}>{n.data.titre}</a></span>
                  <span class="r-cat">{n.data.categories[0]?.nom ?? ''}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </section>
    ))}
  </div>

</Base>

<style>
  .index-annees {
    display: flex;
    flex-wrap: wrap;
    gap: .3em .8em;
    margin: 0 0 2em;
    padding-bottom: 1em;
    border-bottom: 1px dashed var(--parch-dark);
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .85em;
  }

  .annee {
    margin-bottom: 2.4em;
    content-visibility: auto;
    /* contain-intrinsic-size est posé en ligne, année par année. */
    scroll-margin-top: 1em;
  }
  .annee h3 {
    display: flex;
    align-items: baseline;
    gap: .6em;
    font-family: Georgia, serif;
    font-size: 1.3em;
    color: var(--gold-frame);
    border-bottom: 1px solid var(--gold-line);
    padding-bottom: .2em;
    margin-bottom: .6em;
  }
  .an-compte {
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .55em;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .an-haut {
    margin-left: auto;
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .5em;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .mois { margin: 0 0 1.2em; }
  .mois h4 {
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .82em;
    font-weight: normal;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #756435;
    margin: 1em 0 .2em;
  }
  .compte { color: #ada095; text-transform: none; letter-spacing: 0; }
  .mois .liste { padding-left: 1.2em; }
</style>
