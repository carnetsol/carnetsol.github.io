---
import { getCollection } from 'astro:content';
import { notulesPubliees } from '../lib/notules';
import Base from '../layouts/Base.astro';
import NotuleCard from '../components/NotuleCard.astro';
import Pagination from '../components/Pagination.astro';

/**
 * La racine du site sert le même fil que /css/.
 *
 * Deux adresses, un seul contenu : la balise canonique désigne /css/ comme
 * l'adresse de référence, parce que vingt ans de liens externes pointent
 * vers elle. Sans cela, les moteurs verraient deux pages identiques et
 * répartiraient le référencement entre les deux au hasard.
 *
 * La pagination continue sur /css/page/2/ : il n'existe donc qu'une seule
 * chaîne de pages, quel que soit le point d'entrée.
 */
const PAR_PAGE = 50;

const toutes = await notulesPubliees(await getCollection('notules'));
const triees = toutes.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const premieres = triees.slice(0, PAR_PAGE);
const total = triees.length;
const nbPages = Math.max(1, Math.ceil(total / PAR_PAGE));
---
<Base titre="Notules récentes" devise canonique="/css/" antiquites>


  <div class="contenu">
    <div id="fil">
      {premieres.map((notule) => <NotuleCard notule={notule} />)}
    </div>

    <Pagination page={1} nbPages={nbPages} total={total} affichees={premieres.length} />
  </div>

</Base>
