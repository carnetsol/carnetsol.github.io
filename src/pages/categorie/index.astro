---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { notulesPourListe } from '../../lib/notules';

const notules = await notulesPourListe();
const categories = await getCollection('categories');

// Notules par slug de chapitre, de la plus récente à la plus ancienne.
const parChapitre = new Map<string, typeof notules>();
for (const n of notules) {
  for (const c of n.data.categories) {
    if (!parChapitre.has(c.slug)) parChapitre.set(c.slug, []);
    parChapitre.get(c.slug)!.push(n);
  }
}
for (const liste of parChapitre.values()) {
  liste.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
}

/**
 * Ordre voulu, pas ordre alphabétique.
 *
 * Le champ « ordre » de categories.json est posé par
 * scripts/ordonner_categories.py selon la convention suivante :
 *      0 …  999   premier bloc
 *   1000 … 1999   second bloc
 *   2000 … 2999   chapitres non encore classés, alphabétiques
 * Un filet est tracé chaque fois que le millier change : la structure de
 * la page vient donc entièrement des données, rien n'est codé ici.
 */
const listees = categories
  .map((c) => ({ ...c.data, notules: parChapitre.get(c.data.slug) ?? [] }))
  .filter((c) => c.notules.length > 0 && c.nom !== '_')
  .sort((a, b) => a.ordre - b.ordre || a.nom.localeCompare(b.nom, 'fr'));

const bloc = (ordre: number) => Math.floor(ordre / 1000);

/**
 * Hauteur présumée d'un chapitre, pour `content-visibility`.
 * Même raison qu'aux archives : la page affiche désormais les milliers de
 * titres, et sans estimation par chapitre l'ascenseur sauterait pendant le
 * défilement. Calculée à la compilation, chapitre par chapitre.
 */
// Replié, un chapitre tient sur une ligne. C'est cette hauteur-là
// qu'il faut annoncer, pas celle du contenu déroulé.
const hauteur = () => 44;

const total = listees.reduce((s, c) => s + c.notules.length, 0);
---
<Base titre="Chapitres" recherche>

  <div class="contenu">
    <h2 class="section-head">{listees.length} chapitres</h2>

    {listees.map((c, i) => (
      <section
        class:list={['chapitre', { 'debut-bloc': i > 0 && bloc(c.ordre) !== bloc(listees[i - 1].ordre) }]}
        id={`c-${c.slug}`}
        style={`contain-intrinsic-size: auto ${hauteur()}px`}
      >
        {/* <details> plutôt qu'une liste ouverte : 123 chapitres et
            3 500 titres déroulés d'un coup ne se parcourent pas. Fermés,
            les chapitres tiennent sur un écran ou deux et l'on ouvre ce
            qui intéresse. La recherche du navigateur (Ctrl+F) ne voit pas
            le contenu replié : c'est le prix, et c'est pour cela que les
            Archives, elles, restent ouvertes. */}
        <details>
          <summary>
            <span class="ch-nom">{c.nom}</span>
            <span class="ch-compte">
              {c.notules.length} {c.notules.length > 1 ? 'notules' : 'notule'}
            </span>
          </summary>

          {c.description && <p class="ch-desc">{c.description}</p>}

          <p class="ch-page">
            <a href={`/categorie/${c.slug}/`}>Voir le chapitre entier</a>
          </p>

          <ul class="liste">
            {c.notules.map((n) => (
              <li>
                <span class="r-date">
                  {n.data.date.toLocaleDateString('fr-FR', {
                    day: 'numeric', month: 'short', year: 'numeric',
                  })}
                </span>
                <span class="r-title"><a href={n.data.url}>{n.data.titre}</a></span>
              </li>
            ))}
          </ul>
        </details>
      </section>
    ))}
  </div>

</Base>

<style>
  .chapitre {
    margin-bottom: .3em;
    content-visibility: auto;
    scroll-margin-top: 1em;
  }
  .chapitre.debut-bloc {
    border-top: 1px solid var(--gold-line);
    padding-top: 1.8em;
  }
  .chapitre summary {
    display: flex;
    align-items: baseline;
    gap: .6em;
    cursor: pointer;
    padding: .35em 0;
    border-bottom: 1px dashed var(--parch-dark);
    list-style: none;
  }
  .chapitre summary::-webkit-details-marker { display: none; }
  /* Chevron maison : le triangle par défaut n'est pas stylable partout. */
  .chapitre summary::before {
    content: "▸";
    color: var(--gold-line);
    transition: transform .15s;
  }
  .chapitre[open] > details > summary::before,
  .chapitre details[open] > summary::before { content: "▾"; }
  .chapitre details[open] > summary {
    border-bottom: 1px solid var(--gold-line);
  }
  .ch-nom {
    font-family: Georgia, serif;
    font-size: 1.15em;
    color: var(--gold-frame);
  }
  .chapitre details[open] .ch-nom { font-weight: bold; }
  .ch-page {
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .78em;
    margin: .4em 0 .2em;
  }
  .ch-compte {
    margin-left: auto;
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .72em;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ch-desc {
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .8em;
    color: var(--muted);
    margin: 0 0 .6em;
  }
  .chapitre .liste { padding-left: 1.2em; }
</style>
