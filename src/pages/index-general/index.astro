---
import Base from '../../layouts/Base.astro';
---
<Base titre="Index (fragmentaire) &amp; Linktree">
  <div class="contenu">
    <h2 class="section-head">Index (fragmentaire) &amp; Linktree</h2>
    <p class="a-remplir">
      Les entrées les plus consultées, rassemblées à la main.
      Cette page reste à remplir : elle peut soit lister des notules
      d'une catégorie existante, soit devenir une page rédigée à la main.
    </p>
  </div>
</Base>

<style>
  .a-remplir {
    font-family: "Lucida Grande", Verdana, sans-serif;
    font-size: .85em; color: var(--muted); line-height: 1.6;
  }
</style>
